# Plantilla de variables para los tests de integracion contra el SAT
# (test/integration/*). Este archivo SI se commitea; tu `.env` NO (esta en el
# .gitignore de la raiz, que ignora cualquier `.env` a cualquier profundidad).
#
#   cd packages/sat/cfdi_descarga
#   cp env.example .env           # tu copia privada, gitignorada
#   $EDITOR .env                  # pon TUS rutas y contrasena
#   source .env                   # exporta las variables a la shell actual
#   mix test --include real_sat --trace \
#     test/integration/descarga_metadata_real_test.exs
#
# `source` funciona porque cada linea trae `export`. Si prefieres no ensuciar
# tu shell, pasalas inline en el mismo comando (solo viven en ese proceso):
#
#   SAT_FIEL_CER=/ruta/fiel.cer SAT_FIEL_KEY=/ruta/fiel.key \
#     SAT_FIEL_PASSWORD=xxxx SAT_MES=2025-05 \
#     mix test --include real_sat --trace \
#     test/integration/descarga_metadata_real_test.exs
#
# Para dejar de usarlas en la sesion actual:
#
#   unset SAT_FIEL_CER SAT_FIEL_KEY SAT_FIEL_PASSWORD

# ---------------------------------------------------------------------------
# e.firma (FIEL) — OBLIGATORIAS para los tests reales.
# El WS de Descarga Masiva NO acepta CSD: con un CSD el SAT responde 300/305.
# Sugerencia: guarda tu e.firma en packages/files/certificados/fiel/ (esa
# carpeta esta gitignorada) para tenerla a la mano sin riesgo de subirla.
# ---------------------------------------------------------------------------
export SAT_FIEL_CER="/ruta/a/tu/efirma.cer"
export SAT_FIEL_KEY="/ruta/a/tu/efirma.key"
export SAT_FIEL_PASSWORD="tu-contrasena"

# ---------------------------------------------------------------------------
# Rango de fechas. SAT_MES es lo comodo; SAT_FECHA_INICIO/FIN lo sobreescriben.
# Ojo: el SAT permite maximo 2 solicitudes con los MISMOS parametros (RFC +
# rango + tipo). La 3a identica devuelve 5002 permanente: cambia el mes.
# ---------------------------------------------------------------------------
export SAT_MES="2025-05"
# export SAT_FECHA_INICIO="2025-05-01"
# export SAT_FECHA_FIN="2025-05-31"

# ---------------------------------------------------------------------------
# Filtros de la solicitud.
#   SAT_TIPO    recibidos | emitidos  (direccion: elige la operacion SOAP)
#   SAT_ESTADO  todos | vigente | cancelado
#               En metadata SI puedes pedir cancelados; en descarga de CFDI
#               (XML) el SAT solo entrega vigentes y responde 301 si insistes.
# ---------------------------------------------------------------------------
export SAT_TIPO="recibidos"
export SAT_ESTADO="todos"

# ---------------------------------------------------------------------------
# Polling de la verificacion (el SAT tarda en generar el paquete).
# ---------------------------------------------------------------------------
export SAT_POLL_INTERVAL_MS="30000"
export SAT_MAX_ATTEMPTS="20"

# ---------------------------------------------------------------------------
# Depuracion de la salida.
#   SAT_DUMP_FILAS    cuantas filas del TSV imprimir (numero o "all")
#   SAT_DUMP_PAQUETE  "1" vuelca tambien el SOAP del paquete: trae el ZIP en
#                     base64, son MBs en consola. Apagado por default.
#   SAT_TIMEOUT_MS    timeout HTTP (default 30000; subelo si te da :timeout)
# ---------------------------------------------------------------------------
export SAT_DUMP_FILAS="10"
# export SAT_DUMP_PAQUETE="1"
# export SAT_TIMEOUT_MS="90000"

# ---------------------------------------------------------------------------
# IdSolicitud de una solicitud YA registrada. Lo usan los tests que solo
# verifican / descargan, sin registrar una nueva (verificar no gasta cuota).
# Los paquetes viven 72h: pasado eso el estado es :vencida.
# ---------------------------------------------------------------------------
export SAT_ID_SOLICITUD="1e0b9d7a-138b-4426-8d53-b8165601da13"
